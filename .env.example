# Camera/video input
CAMERA_INDEX=0
CAMERA_NAME=Laptop Camera

# Model runtime
LSTM_MODEL_PATH=models_4_clean/seq30/lstm_best_seq30.h5
SEQUENCE_LEN=30
FALL_THRESHOLD=0.50
FALL_LOW_THRESHOLD=0.55
FALL_HIGH_THRESHOLD=0.60
